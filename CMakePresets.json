{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-rel",
      "displayName": "Windows MSVC Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SLIC3R_STATIC": "ON",
        "ENABLE_SLA": "ON",
        "USE_OPENVDB": "ON"
      }
    },
    {
      "name": "supporter-updater",
      "displayName": "Supporter Updater Overlay",
      "inherits": "windows-msvc-rel",
      "cacheVariables": {
        "LIBRESLICER_ENABLE_UPDATER": "ON",
        "LIBRESLICER_ENABLE_UPDATE_CHECKER": "ON",
        "LIBRESLICER_VENDOR_HOST": "updates.libreslicer.dev",
        "LIBRESLICER_VERSION_CHECK_URL": "https://updates.libreslicer.dev/releases/version.manifest",
        "LIBRESLICER_INDEX_ARCHIVE_URL": "https://updates.libreslicer.dev/vendor/vendor_indices.zip",
        "LIBRESLICER_PROFILE_FOLDER_URL": "https://updates.libreslicer.dev/vendor/profiles"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "rel",
      "configurePreset": "windows-msvc-rel"
    },
    {
      "name": "supporter-updater-rel",
      "configurePreset": "supporter-updater"
    }
  ]
}
